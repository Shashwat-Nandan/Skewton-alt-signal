[Unit]
Description=Kalman Pair Paper Runner — time-varying hedge ratio (forward A/B test)
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# Cap a crashloop at 5 restarts within 10 minutes — past that systemd gives up
# and notify-failure@ alerts rather than burning CPU.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=simple so Restart=on-failure covers mid-session crashes (oneshot blocks
# Restart=, leaving a crash unrecovered until the next day's timer).
Type=simple
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# PAPER ONLY — the Kalman strategy raises NotImplementedError on --mode live
# until the forward test validates an edge (Phase 2 = conditional GO). Runs on
# the same candidate universe as pair-paper so the books are comparable.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python /opt/taleb-karpathy-kite/run_paper_kalman_pairs.py --top 10 --max-leg-notional 1000000
# -------------------------------

# Auto-restart on crash / non-zero exit. A clean 15:25 IST teardown returns 0
# and does NOT trigger restart, so the timer pattern still works.
Restart=on-failure
RestartSec=30
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches pair-paper.service / arbitrage-paper.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# Do NOT set ProtectHome=true if WorkingDirectory is under /root or /home — it
# hides the dir from the unit's mount namespace (status=200/CHDIR). See
# tasks/lessons.md (2026-05-12 incident).
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
