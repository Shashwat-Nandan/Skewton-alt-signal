[Unit]
Description=Latch HALT_ALL when the LIVE pair runner hard-stops (crash-loop / terminal failure)
# Intentionally no OnFailure= — a latch/alert unit must not loop on its own failure.

[Service]
Type=oneshot
# --- EDIT FOR YOUR VPS ---
Environment=PROJECT_DIR=/opt/taleb-karpathy-kite
EnvironmentFile=-/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/pair-live-halt-on-failure.sh
# -------------------------

# Tight sandbox — reads env, queries systemd, runs curl + logger, and WRITES the
# HALT_ALL flag. ProtectSystem=strict makes the FS read-only, so data_cache must
# be re-exposed via ReadWritePaths or the touch fails on a read-only filesystem.
ReadWritePaths=/opt/taleb-karpathy-kite/data_cache
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only is safe here: this unit only READS its script + .env, and
# the HALT_ALL write goes through ReadWritePaths (which overrides ProtectHome).
# Matters most on a /root-localized host, where data_cache sits under a home dir —
# unlike the live runner (WorkingDirectory under /root → must NOT set ProtectHome),
# this oneshot sets no WorkingDirectory.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=30
