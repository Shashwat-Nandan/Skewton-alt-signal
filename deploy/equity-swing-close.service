[Unit]
Description=Equity Swing — post-close scan (full feature compute, entries + exits)
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# Sequence after fetch-bars (Kite 30-min), fetch-bhavcopy-eq (EQ
# daily bhavcopy, 18:00 IST) and fetch-fii-dii (17:00 IST). The
# strategy now fails loud if today's EQ bar isn't in the panel, so
# fetch-bhavcopy-eq is effectively a hard dependency at runtime.
After=fetch-bars.service fetch-bhavcopy-eq.service fetch-fii-dii.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_equity_swing --scan close --mode paper
# -------------------------------

TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
