[Unit]
Description=Failure notifier for %i
# Intentionally no OnFailure= here — a failing notifier must not loop.

[Service]
Type=oneshot
# --- EDIT FOR YOUR VPS ---
EnvironmentFile=-/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/notify-failure.sh %i
# -------------------------

# Tight sandbox — this unit only reads env, runs curl, calls logger.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=30
