[Unit]
Description=Fire pair-live-watchdog every 5 min Mon–Fri (session window enforced in-script, IST)

[Timer]
# Host system time is CEST; 05:45–11:55 CEST ≈ 09:15–15:25 IST. The
# script applies the precise 09:20–15:20 IST window + holiday gate, so a
# DST shift only widens/narrows the outer envelope, never the alarms.
OnCalendar=Mon..Fri *-*-* 05..11:0/5:00
Persistent=false

[Install]
WantedBy=timers.target
