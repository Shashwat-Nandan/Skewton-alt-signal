[Unit]
Description=Taleb-Karpathy — daily pair-trading cointegration screen
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/run_weekly_pair_screen.sh
# -------------------------------

# bhavcopy fetch dominates (39 trading days × NSE rate-limited downloads ≈
# 10-14 min on a slow afternoon); daily screen ~1 min; persistent screen
# 9 windows × ~5s ≈ 1 min. 15 min was too tight — 2026-05-21 hit timeout
# mid persistent-screen W1. 45 min gives comfortable headroom.
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
