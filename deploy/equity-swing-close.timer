[Unit]
Description=Fire equity-swing-close.service Mon–Fri at 18:30 IST
Documentation=man:systemd.timer(5)

[Timer]
# 18:30 IST — sequenced AFTER fetch-fii-dii.timer (17:00) and
# fetch-bhavcopy-eq.timer (18:00) so the strategy operates on today's
# settled EQ bhavcopy and the day's FII/DII flow. NSE publishes the
# UDiFF cash-market bhavcopy ~17:30-18:00 IST, so 18:30 leaves a
# 30-min buffer for fetcher retries and per-symbol cache rebuild.
#
# Previously fired at 15:35 (5 min after close), which was too early
# for the EQ bhavcopy and left the strategy scanning a stale panel.
OnCalendar=Mon..Fri *-*-* 18:30:00 Asia/Kolkata

# Persistent catch-up: the close scan IS the entries scan, so a late
# fire might open positions stale by a day. That's still preferable to
# missing the day entirely; the next day's open scan will run exits
# against intraday levels and the next close scan will refresh
# everything. If that's undesirable on your deployment, set this to
# false.
Persistent=true

RandomizedDelaySec=60

Unit=equity-swing-close.service

[Install]
WantedBy=timers.target
