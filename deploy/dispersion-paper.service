[Unit]
Description=Dispersion Paper Runner — two Nifty dispersion books (matched + short-vol), paper only
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# Cap a crashloop at 5 restarts within 10 minutes — past that systemd gives up
# and notify-failure@ alerts rather than burning CPU forever. A state file that
# will not restore makes the runner refuse to start (exit 1) without touching
# either book's state; the restarts exhaust the limit before 15:00 and alert.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=simple (not oneshot) so Restart=on-failure recovers a crash inside the
# 15:00–15:20 decision window.
Type=simple
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# PAPER ONLY. DispersionPaperStrategy raises for mode=live and the runner has
# no --mode flag. It quotes with the Kotak consumer key and never calls
# login(), so it cannot rotate the trade token a live runner is holding.
# Two books share one set of quotes: dispersion_paper (Bloch §7.6.5.1
# notional match, NSE free-float weights) and dispersion_short_vol_paper (the
# PR 9 sizing). No flags: the research size cap (200 index lots) is the
# signed-off book, and a restored state keeps its own cap.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_paper_dispersion
# -------------------------------

# The runner exits 0 when the 15:20 window closes (or at once on a holiday /
# after 15:30), which does NOT trigger a restart.
Restart=on-failure
RestartSec=30
# Exit 3 = the heartbeat saw every pass fail (SILENT_FAIL_dispersion_paper is
# touched). Do not restart: a fresh process resets the count and can reach
# 15:20 and exit 0 with the window's hedge/settle never done. Failing the
# unit fires notify-failure@ (runners/run_paper_dispersion.SILENT_FAIL_EXIT).
RestartPreventExitStatus=3
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches buy-on-gap-paper.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true if WorkingDirectory is under /root or /home
# (the unit fails at status=200/CHDIR before ExecStart). See tasks/lessons.md.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
