[Unit]
Description=Strategy Dashboard — FastAPI backend
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# Bind localhost only — nginx fronts the public traffic on :80/:443.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/uvicorn backend.main:app \
    --host 127.0.0.1 --port 8000 \
    --log-level info --no-access-log
# -------------------------------

# Long-running process — restart on crash but back off so a tight crash
# loop doesn't hammer Kite's API.
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
