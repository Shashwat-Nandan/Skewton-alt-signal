[Unit]
Description=Telegram EOD P&L summary — LIVE persistent pair runner
# No OnFailure= — an alerting unit must not loop on its own failure.

[Service]
Type=oneshot
# --- EDIT FOR YOUR VPS ---
Environment=PROJECT_DIR=/opt/taleb-karpathy-kite
Environment=TZ=Asia/Kolkata
EnvironmentFile=-/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/pair-eod-telegram.sh
# -------------------------

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=30
