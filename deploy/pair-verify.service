[Unit]
Description=Pair-Trading EOD verifier — paper P&L vs trailing backtest
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m scripts.verify_pair_paper
# -------------------------------

# Trailing-60d replay across N pairs is bounded; 10 min ceiling is generous.
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal

# Hardening (matches screen-pairs.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true here. If WorkingDirectory is under
# /root or /home (as on the dev VPS), ProtectHome=true hides it from the
# unit's mount namespace and the unit fails at status=200/CHDIR before
# ExecStart runs — silently, since the timer just reschedules. See
# tasks/lessons.md for the 2026-05-12 incident.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
