[Unit]
Description=Market-Profile feature logger — nightly Dalton indicators → dashboard.db
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=oneshot: this is a read-only batch job that computes DayIndicators from
# already-stored bars and appends to mp_features. No market-hours dependency, no
# mid-session crash to recover — so oneshot (not simple+Restart) is correct.
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
# No EnvironmentFile: the logger reads local dashboard.db only — it needs NO
# Kite auth. (Kept commented so it's obvious this is deliberate.)
# EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python /opt/taleb-karpathy-kite/log_mp_features.py --source intraday
# -------------------------------

StandardOutput=journal
StandardError=journal

# Hardening (matches arbitrage-paper.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache
# NOTE: do NOT set ProtectHome=true if WorkingDirectory is under /root or /home
# (status=200/CHDIR before ExecStart). See tasks/lessons.md (2026-05-12).
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
