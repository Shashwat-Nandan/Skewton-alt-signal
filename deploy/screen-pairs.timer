[Unit]
Description=Fire screen-pairs.service every weekday evening (19:00 IST)

[Timer]
# Weekday 19:00 IST: NSE close is 15:30 and the F&O bhavcopy is typically
# published by ~18:00, so an hour of slack covers normal publish lag. Fresh
# candidates land well before next-morning open. Weekends skipped — no new
# bhavcopy is published. Daily cadence keeps the candidate list responsive
# to drift in cointegration relationships.
OnCalendar=Mon..Fri *-*-* 19:00:00 Asia/Kolkata

# If the VPS was offline at the scheduled fire, run as soon as it comes up.
Persistent=true

# Spread load if multiple boxes ever share infra.
RandomizedDelaySec=300

Unit=screen-pairs.service

[Install]
WantedBy=timers.target
