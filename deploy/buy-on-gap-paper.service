[Unit]
Description=Buy-on-Gap Paper Runner — intraday mean reversion on NIFTY-200
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# Cap a crashloop at 5 restarts within 10 minutes — past that systemd gives up
# and notify-failure@ alerts rather than burning CPU forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# Type=simple (not oneshot) so Restart=on-failure recovers a mid-session crash.
Type=simple
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# Tunables (gap threshold, trend filter, stop, sizing) live in config.ini
# [buy_on_gap]; the flags below override them for the deployed paper run. NOTE:
# this strategy has NO live mode (BuyOnGapStrategy raises for mode=live).
#
# --gap-std-mult 2.0 --no-trend-filter = the OOS-survivor config. The in-code /
# config defaults are book-faithful (k=1.0, trend on) and lose out-of-sample;
# only the deep-gap, trend-off variant stayed positive in the 2025-06→2026-06
# test split (Sharpe ~0.46), so that's what we forward-test on paper. Drop
# these two flags to fall back to the book-faithful default.
#
# --total-capital 300000 (2026-07-11 review): per-name notional ₹60k, so the
# pre-registered kill rule is decided by its WIN-RATE leg (15 trades < 35%)
# rather than the -₹50k floor after a handful of ₹10k stop-outs — same
# evidence, ~1/3 the paper bleed. The cumulative floor was already ₹39.3k
# consumed at ₹1M sizing when this was cut.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python /opt/taleb-karpathy-kite/run_paper_buy_on_gap.py --max-daily-loss-inr 30000 --gap-std-mult 2.0 --no-trend-filter --total-capital 300000
# -------------------------------

# A clean 15:25 IST teardown returns 0 and does NOT trigger restart, so the
# timer pattern still works. StartLimit caps a crashloop.
Restart=on-failure
RestartSec=30
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches arbitrage-paper.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true if WorkingDirectory is under /root or /home
# (the unit fails at status=200/CHDIR before ExecStart). See tasks/lessons.md.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
