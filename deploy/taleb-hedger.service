[Unit]
Description=Taleb Dynamic Hedger — paper trading session
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE THREE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_paper
# ------------------------------------

# Oneshot sessions should not auto-restart mid-day — the timer fires again tomorrow.
# Paper mode exits cleanly at 15:25 IST.
TimeoutStartSec=0
# runners/run_paper.py installs a SIGTERM→KeyboardInterrupt handler so `systemctl
# stop`/restart runs the EOD teardown and exits 130. Whitelist 130 as
# success so a clean operator stop doesn't fire OnFailure (audit 2.1/2.6).
# A genuine silent-fail breach exits 1 → OnFailure still alerts.
SuccessExitStatus=130
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
