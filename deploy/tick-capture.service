[Unit]
Description=Tick Capture — KiteTicker WebSocket for trigger-fair-value research
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE THREE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python /opt/taleb-karpathy-kite/tick_capture.py --underlyings NIFTY,BANKNIFTY --strikes-each-side 20
# ------------------------------------

# Oneshot session — exits cleanly at 15:30 IST. Timer fires again tomorrow.
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches pair-paper.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true here. If WorkingDirectory is under
# /root or /home (as on the dev VPS), ProtectHome=true hides it from the
# unit's mount namespace and the unit fails at status=200/CHDIR before
# ExecStart runs — silently, since the timer just reschedules. See
# tasks/lessons.md for the 2026-05-12 incident.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
