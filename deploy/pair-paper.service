[Unit]
Description=Pair-Trading Paper Runner — top-N cointegrated NIFTY-50 STF pairs
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# M-O5: StartLimit* live in [Unit], not [Service]. Cap a crashloop at 5
# restarts within 10 minutes — past that systemd gives up and
# notify-failure@ alerts rather than burning CPU forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# M-O5: Type=simple (not oneshot) so Restart=on-failure kicks in for
# mid-session crashes. Oneshot blocks Restart=, leaving a segfault at
# 11:00 IST unrecovered until the next day's timer at 09:15 IST.
Type=simple
# --- EDIT THESE THREE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# --top, --max-leg-notional and tunables live here so config changes don't
# require a rebuild. Override on the VPS by `systemctl edit pair-paper.service`.
#
# --max-daily-loss-inr 100000 (₹1 lakh, 2026-07-18): a real breaker for the
# baseline paper book. This is now SAFE to make reachable because the runner's
# daily-loss flag is namespaced per --system (run_paper_pairs.halt_daily_loss_path):
# --system baseline touches data_cache/HALT_DAILY_LOSS_baseline, which the LIVE
# persistent runner (canonical data_cache/HALT_DAILY_LOSS) does NOT read — so a
# paper breach can no longer halt the live book. (The operator HALT_ALL /
# HALT_NEW_ENTRIES switches stay shared by design.) Was 100000000/unreachable
# back when the flag was shared; see tasks/todo.md (2026-07-18 baseline top-8).
#
# --top 8 (was 12, 2026-07-18): tighter top-8 cointegrated universe as the
# paper-validation config ahead of a future live-alongside cutover. Stays PAPER
# (no --mode live) until top-8 clears its own paper window (safety rule 3). The
# host runs this via a systemd drop-in (pair-paper.service.d/10-top8.conf); see
# tasks/todo.md (2026-07-18 baseline top-8) for the deferred live prerequisites.
# --max-book-notional-inr 4000000 (2026-08-07): the runner had NO book-level
# cap (the flag defaults to 0 = disabled), so open positions only ever left the
# book by exiting. Between 07-23 and 08-07 the baseline went from 8 pairs to 13
# (8 selected + 5 orphans) and its open notional reached ₹8.24M against ₹1M of
# strategy capital — ~8× leverage, and cross-stock pairs get NO SPAN netting
# (both legs margin in full), so that is not affordable. ₹4M ≈ 3 concurrent
# pairs at the current ~₹1.37M/pair.
#
# NOTE: deploy/pair-paper.service.d/10-top8.conf resets and redefines
# ExecStart, so the line below is NOT what runs wherever that drop-in is
# installed. Both carry the same flags by design (see the drop-in's
# "belt-and-suspenders" note) — change them together, or the drop-in wins
# silently. The 2026-08-07 host had a base unit predating the top-8 template,
# which is exactly the case the drop-in exists to cover.
#
# The cap is scoped to THIS runner's own state file
# (data_cache/pair_paper_state_baseline.json), matching how
# halt_daily_loss_path namespaces the daily-loss breaker per --system. It was
# briefly a cross-runner sum, which would have let the LIVE persistent book
# freeze this paper runner's entries — the HALT_NEW_ENTRIES failure shape
# (PR #196). H17's leg-concentration counter still reads sibling runners; that
# coupling is deliberate and separate.
#
# NOTE: the cap gates NEW ENTRIES ONLY; it never force-closes. With the
# baseline book at ₹8.24M on 2026-08-07 no new entry fires until natural exits
# bring it under ₹4M.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_paper_pairs --top 8 --max-leg-notional 1000000 --max-daily-loss-inr 100000 --max-book-notional-inr 4000000
# ------------------------------------

# M-O5: auto-restart on segfault / non-zero exit. Successful exit (clean
# 15:25 IST teardown) returns 0 and does NOT trigger restart, so the
# timer pattern still works. StartLimit caps a crashloop at 5 restarts
# within 10 minutes — past that systemd gives up so notify-failure@
# alerts rather than burning a CPU forever.
Restart=on-failure
RestartSec=30
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches taleb-hedger.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true here. If WorkingDirectory is under
# /root or /home (as on the dev VPS), ProtectHome=true hides it from the
# unit's mount namespace and the unit fails at status=200/CHDIR before
# ExecStart runs — silently, since the timer just reschedules. See
# tasks/lessons.md for the 2026-05-12 incident.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
