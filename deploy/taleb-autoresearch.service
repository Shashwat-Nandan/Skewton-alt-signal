[Unit]
Description=Taleb Dynamic Hedger — weekly autoresearch parameter sweep
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/run_weekly_autoresearch.sh
# -------------------------------

# Autoresearch can take a while (40 experiments × eval_cycles sessions each).
# No restart on failure: investigate via journalctl and re-fire next week.
# 10h (was 4h): 2026-06-14 widened eval-cycles 3→5 (full Mon–Fri week per
# experiment), so a full sweep runs ~6h (~9 min × 40 exp) vs the prior ~3.5h.
# The 4h cap would SIGTERM the 5-cycle run ~2/3 through. 10h leaves comfortable
# margin for a slow/loaded host while still bounding a genuinely hung run.
# (History: 2h cap SIGTERM'd the 2026-06-06 run at 25/40 → raised to 4h.)
TimeoutStartSec=10h
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
