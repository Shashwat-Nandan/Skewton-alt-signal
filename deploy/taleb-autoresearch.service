[Unit]
Description=Taleb Dynamic Hedger — weekly autoresearch parameter sweep
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/run_weekly_autoresearch.sh
# -------------------------------

# Autoresearch can take a while (40 experiments × 3 cycles × 5-day windows).
# No restart on failure: investigate via journalctl and re-fire next week.
# 4h (was 2h): under the 2026-06-01 config (gamma_theta_ratio, eval-cycles 3,
# full captured-tape replay of ~1.2GB sessions) a full sweep runs ~3.1h
# (~4.7 min × 40 exp). The 2h cap SIGTERM'd the 2026-06-06 run at 25/40.
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
