[Unit]
Description=Fire kalman-pairs-paper.service Mon–Fri at 09:14 IST
Documentation=man:systemd.timer(5)

[Timer]
# 09:14 IST — staggered after taleb-hedger (09:10), pair-paper (09:11/09:12),
# and arbitrage-paper (09:13) so the TOTP logins don't collide on the shared
# .kite_session.json. run_paper_kalman_pairs.py self-gates on 09:15 anyway, so
# it waits for the open regardless.
OnCalendar=Mon..Fri *-*-* 09:14:00 Asia/Kolkata

# If the VPS was asleep or systemd missed the window, run once to catch up.
# The runner refuses to start after 15:30, so Persistent is safe.
Persistent=true

# Jitter to avoid thundering-herd Kite logins on multi-account VPSes.
RandomizedDelaySec=60

Unit=kalman-pairs-paper.service

[Install]
WantedBy=timers.target
