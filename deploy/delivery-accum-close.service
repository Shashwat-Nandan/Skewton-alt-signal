[Unit]
Description=Delivery Accumulation — post-close scan (pending fills, exits, new entry queue)
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
# Hard runtime dependency: the runner refuses to scan if today's EQ bar is
# missing from the panel, so fetch-bhavcopy-eq (18:00 IST) must have run.
# Delivery data itself is consumed at lag 1 (yesterday's 19:45 fetch).
After=fetch-bhavcopy-eq.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_delivery_accum --scan close --mode paper
# -------------------------------

TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
