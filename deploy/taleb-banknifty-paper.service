[Unit]
Description=Taleb Dynamic Hedger (BANKNIFTY) — isolated paper session (issue #62)
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# Second, FULLY ISOLATED Taleb instance: a self-contained cold BANKNIFTY config
# (creds from the shared .env). State/lock/log are isolated by underlying
# (taleb_paper_state_BANKNIFTY.json, .taleb_paper_BANKNIFTY.lock,
# paper_BANKNIFTY-*.log), so it runs concurrently with the NIFTY
# taleb-hedger.service without touching its state. PAPER-ONLY.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m runners.run_paper --config /opt/taleb-karpathy-kite/config_banknifty.ini
# --------------------------------

TimeoutStartSec=0
# runners/run_paper.py installs a SIGTERM→KeyboardInterrupt handler → clean stop exits
# 130; whitelist it so an operator stop doesn't false-page OnFailure. A genuine
# silent-fail breach exits 1 → OnFailure still alerts.
SuccessExitStatus=130
StandardOutput=journal
StandardError=journal

# Hardening (mirrors taleb-hedger.service)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
# NOTE: do NOT set ProtectHome=true here. If WorkingDirectory / .venv / .env are
# under /root or /home (as on the dev VPS), ProtectHome=true hides them from the
# unit's mount namespace and the unit fails (203/EXEC — the interpreter path
# vanishes) before the strategy runs — silently, since the timer just
# reschedules. Mirrors pair-paper.service; see tasks/lessons.md (2026-05-12).
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
