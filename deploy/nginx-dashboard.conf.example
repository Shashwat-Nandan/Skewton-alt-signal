# Nginx site config for the strategy dashboard.
#
# Serves the SPA (frontend/dist) as static files and proxies API calls
# to the uvicorn backend listening on 127.0.0.1:8000. Drop into
# /etc/nginx/sites-available/dashboard, symlink to sites-enabled, and
# reload nginx.
#
# Replace dashboard.example.com with your real hostname. For HTTPS,
# add cert paths under listen 443 ssl; certbot's --nginx will edit
# this file in place.
#
# This config expects a rate-limit zone defined at the http level —
# typically /etc/nginx/conf.d/dashboard-ratelimit.conf:
#     limit_req_zone $binary_remote_addr zone=dashboard_login:10m rate=10r/m;

server {
    listen 80;
    server_name dashboard.example.com;

    # ── Security headers ─────────────────────────────────────────
    # HSTS only does anything on HTTPS; certbot's --nginx will keep these
    # add_header lines in place when it converts listen to 443 ssl.
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    # ── Rate-limited login endpoint ──────────────────────────────
    # `location = /session/login` matches before the regex below so the
    # rate-limit applies just to this path. burst=5 + nodelay = a real
    # operator can fast-retry a typo, but a brute-force attempt eats the
    # budget within seconds and gets 429s.
    location = /session/login {
        limit_req zone=dashboard_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    # Backend API — six prefixes only. Anything else falls through
    # to the SPA. Keep this list in sync with the routers registered in
    # backend/main.py. /session is the dashboard-password gate; everything
    # else is gated behind it server-side.
    location ~ ^/(session|auth|strategies|runs|market-profile|pair-candidates)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Backend is internal — close on idle to keep the FD pool small.
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    # SPA static + HTML5 router fallback. The SPA bundle is hashed by
    # Vite, so /assets/* can be cached aggressively.
    root /opt/taleb-karpathy-kite/frontend/dist;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    # Block direct access to the dotfiles that live in the project root.
    location ~ /\. { deny all; return 404; }

    # Defence-in-depth: nothing under /logs/ or /data_cache/ should ever be
    # reachable through the SPA root. The fallthrough to try_files /index.html
    # would otherwise quietly serve the SPA on a request like /logs/foo —
    # but a future try_files change could turn this into real exposure.
    location ~ ^/(logs|data_cache)(/|$) { return 404; }
}
