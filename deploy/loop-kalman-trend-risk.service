[Unit]
Description=Loop-Engineering Risk Monitor — kalman_trend (isolated kill switch, §VII-D)
Documentation=https://github.com/anthropics/claude-code
Wants=network-online.target
After=network-online.target
OnFailure=notify-failure@%n.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# --- EDIT THESE FOR YOUR VPS ---
User=taleb
WorkingDirectory=/opt/taleb-karpathy-kite
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Kolkata
EnvironmentFile=/opt/taleb-karpathy-kite/.env
# Runs in its OWN process, deliberately NOT inside the orchestrator (§VII-D: a
# monitor that shares the maker's context drifts with it and never fires). Polls
# the runner state file's realized P&L every 60s until 15:25 and trips
# HALT_NEW_ENTRIES on a drawdown-from-peak breach. Reads ONLY the state file — no
# Kite session, so no TOTP collision with the orchestrator.
ExecStart=/opt/taleb-karpathy-kite/.venv/bin/python -m loop_engine.risk_monitor
# -------------------------------

Restart=on-failure
RestartSec=30
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Hardening (matches the other paper runners)
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taleb-karpathy-kite/logs /opt/taleb-karpathy-kite/data_cache /opt/taleb-karpathy-kite
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
