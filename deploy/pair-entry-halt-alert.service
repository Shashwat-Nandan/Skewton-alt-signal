[Unit]
Description=Telegram alert — LIVE pair runner latched its own entry halt

[Service]
Type=oneshot
Environment=PROJECT_DIR=/opt/taleb-karpathy-kite
EnvironmentFile=-/opt/taleb-karpathy-kite/.env
ExecStart=/opt/taleb-karpathy-kite/deploy/pair-entry-halt-alert.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
TimeoutStartSec=30
