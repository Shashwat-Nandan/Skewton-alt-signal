# Top-level runtime dependencies. Edit this file when adding/removing a
# direct dep, then regenerate `requirements.lock` with:
#
#   uv pip compile requirements.in \
#     --generate-hashes --output-file requirements.lock \
#     --python-version 3.11
#
# Do not pin versions here — the lockfile is the source of pinned truth.

# Web/backend
fastapi
itsdangerous            # SessionMiddleware (Starlette) requires this
pydantic
pydantic-settings
python-dotenv
starlette
uvicorn                 # ExecStart entrypoint in dashboard-backend.service

# Broker integration
kiteconnect

# Numerics / analytics
numpy
pandas
scipy
statsmodels
cmaes                   # CMA-ES optimizer for the Kalman trend-following fit
pyarrow                 # Parquet engine for data_cache tables (storage increment 1)

# Auth
pyotp

# Signal plane (issue #90)
jsonschema>=4.18        # draft 2020-12 validator for the §4 signal contract
