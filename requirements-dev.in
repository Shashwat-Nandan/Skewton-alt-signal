# Regenerate with:
#
#   uv pip compile requirements-dev.in \
#     --generate-hashes --output-file requirements-dev.lock \
#     --python-version 3.11 \
#     --constraint requirements.lock

pytest
httpx                   # required by fastapi.testclient.TestClient
fakeredis               # in-process Redis (incl. Streams) for signal-plane bus tests — no daemon in CI
