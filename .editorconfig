# EditorConfig — baseline so every editor agrees on the basics.
# https://editorconfig.org  (editor-side only; does not reformat existing files)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks — don't strip it.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
